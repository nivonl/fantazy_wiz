# football-data.org free API token (sign up at https://www.football-data.org/client/register)
# Used to pull La Liga (competition PD) historical fixtures/results for the strength-rating fit.
FOOTBALL_DATA_TOKEN=

# Your FPL manager/entry ID (find it in the URL when viewing "My Team" on fantasy.premierleague.com,
# e.g. .../entry/1234567/event/1 -> entry ID is 1234567). No password needed, entry reads are public.
FPL_ENTRY_ID=

# Local SQLite file (relative to fantasy_app/ working directory unless absolute).
DATABASE_URL=sqlite:///./data.db
