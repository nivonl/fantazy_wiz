{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	root * dist

	# Vite's build output under /assets/ is content-hashed (a new build always produces a new
	# filename), so it's safe to cache forever. Everything else -- index.html and every static
	# page's own .html -- must always be revalidated: with no explicit Cache-Control at all
	# (Railpack's default Caddyfile, which this replaces, sets none), browsers fall back to their
	# own heuristic caching, and can keep an old index.html around past a new deploy, referencing
	# a JS bundle hash the new build no longer has. That 404s silently, so the page shell renders
	# but React never mounts -- exactly the "only the background renders" report this fixes.
	# Heuristic caching differs by browser, which is why this can reproduce in one and not
	# another even though every visitor hits the same deploy.
	@immutable_assets {
		path /assets/*
	}
	header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

	@revalidate {
		not path /assets/*
	}
	header @revalidate Cache-Control "no-cache"

	# Client-side-only routes (React Router, no matching file in dist/) -- explicit list rather
	# than a blanket SPA fallback, so a real typo in any other path still 404s instead of
	# silently serving the homepage.
	@spa_routes path /fpl-team-analyzer /fpl-transfer-finder /fpl-squad-builder /fpl-predictions /methodology /more
	rewrite @spa_routes /index.html

	encode {
		gzip
		zstd
	}

	file_server {
		hide .git
		hide .env*
	}

	try_files {path} {path}.html {path}/index.html

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
